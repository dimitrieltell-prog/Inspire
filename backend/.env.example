# Copy this file to .env and fill in real values.

# Set to "true" to use a real MongoDB instance. Leave "false" to run
# entirely in-memory (no external DB needed) -- great for local dev/demo.
USE_MONGO=false
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGO_DB_NAME=inspire

# Set to "true" once you add a real key below to make Aria call OpenAI.
# Leave "false" to use the built-in canned reflective responses (no API key needed).
USE_OPENAI=false
OPENAI_API_KEY=sk-...

# Used to sign auth tokens. Change this to a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# Google OAuth Client ID (Web application), from Google Cloud Console.
# Must match VITE_GOOGLE_CLIENT_ID on the frontend. Leave blank to disable
# "Sign in with Google" -- the button just won't render.
GOOGLE_CLIENT_ID=

# Stripe -- leave all three blank to fall back to the dev-only mock upgrade
# endpoint. Set all three to enable real Checkout + webhook-driven upgrades.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Free-tier Aria limit
ARIA_FREE_DAILY_LIMIT=5

CORS_ORIGINS=http://localhost:5173

# Used to build Stripe Checkout success/cancel redirect URLs.
FRONTEND_URL=http://localhost:5173

# Gates GET /admin/stats?key=... (returns total user count). Leave blank to
# disable the endpoint entirely.
ADMIN_KEY=

# Comma-separated emails that always get Founder status (and Premium for free),
# no matter what's in the DB. Use this for the owner's account.
FOUNDER_EMAILS=
