VITE_API_URL=http://127.0.0.1:8756

# Google OAuth Client ID (Web application), from Google Cloud Console.
# Must match GOOGLE_CLIENT_ID on the backend. Leave blank to disable
# "Sign in with Google" -- the button just won't render.
VITE_GOOGLE_CLIENT_ID=

# Cloudinary, for photo/video uploads on story posts. These are meant to be
# public (an unsigned upload preset has no secret attached) -- safe to expose
# in frontend code. Leave blank to disable uploads (posts still work, just
# without media).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
